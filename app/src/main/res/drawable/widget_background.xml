<?xml version="1.0" encoding="utf-8"?>
<!-- The widgets' card: night-blue to ink, rounded, with a hairline edge. Drawn as a drawable so the corners are round on every Android version. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="300" android:startColor="#FF1A2742" android:centerColor="#FF111A2B" android:endColor="#FF0B1018" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
