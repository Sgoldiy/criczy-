rules_version = '2';

// Criczy fan community. Paste into Firebase Console > Firestore Database > Rules > Publish.
// Members sign in anonymously and choose only a username. Posts, votes and reports carry
// expireAt; TTL policies on that field delete them after 24 hours.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function doc(path) { return /databases/$(database)/documents/$(path); }
    function me() { return request.auth.uid; }
    function validName(n) { return n is string && n.matches('^[A-Za-z0-9_]{3,20}$'); }
    function within24h(t) {
      return t is timestamp && t > request.time && t < request.time + duration.value(25, 'h');
    }

    // Usernames are unique: one document per lower-cased name, created with the user document.
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && getAfter(doc('users/' + me())).data.username.lower() == name;
      // Deleting the account frees the name.
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /users/{uid} {
      allow get: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && validName(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && getAfter(doc('usernames/' + request.resource.data.username.lower())).data.uid == uid;
      // Posting stamps one allowance, to now: lastPostAt once every 24 hours, or
      // lastMatchPostAt (an extra post during a live match) once every 4 hours.
      function stamp(field, gapHours) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
          && request.resource.data[field] == request.time
          && (!(field in resource.data) || request.time > resource.data[field] + duration.value(gapHours, 'h'));
      }
      allow update: if signedIn() && me() == uid && (stamp('lastPostAt', 24) || stamp('lastMatchPostAt', 4));
      allow delete: if signedIn() && me() == uid;
    }

    match /communities/{community}/posts/{postId} {
      function post() { return request.resource.data; }
      function author() { return get(doc('users/' + me())).data; }

      function validPost() {
        return community.matches('^(all|team-[0-9]+)$')
          && post().keys().hasOnly(['uid', 'username', 'text', 'kind', 'options', 'c0', 'c1', 'c2', 'c3', 'reports', 'createdAt', 'expireAt', 'matchId'])
          && post().uid == me()
          && post().username == author().username
          && post().text is string && post().text.size() > 0 && post().text.size() <= 280
          && ((post().kind == 'opinion' && post().options.size() == 0)
              || (post().kind == 'poll' && post().options is list && post().options.size() >= 2 && post().options.size() <= 4))
          && post().c0 == 0 && post().c1 == 0 && post().c2 == 0 && post().c3 == 0 && post().reports == 0
          && post().createdAt == request.time
          && within24h(post().expireAt)
          // Posted together with a stamp on users/{uid}, whose rule enforces the allowance.
          && (getAfter(doc('users/' + me())).data.get('lastPostAt', null) == request.time
              || (post().get('matchId', null) is int && getAfter(doc('users/' + me())).data.get('lastMatchPostAt', null) == request.time));
      }

      // Match polls ("Who wins?", "Player of the match?") are opened by the first phone to
      // reach them, under a fixed id, as the app rather than as a member.
      function validMatchPoll() {
        return postId.matches('^match-[0-9]+-(win|pom)-' + community + '$')
          && post().keys().hasOnly(['uid', 'username', 'text', 'kind', 'options', 'c0', 'c1', 'c2', 'c3', 'reports', 'createdAt', 'expireAt', 'matchId'])
          && post().uid == 'criczy' && post().username == 'Criczy'
          && post().kind == 'poll' && post().options is list && post().options.size() >= 2 && post().options.size() <= 4
          && post().text is string && post().text.size() > 0 && post().text.size() <= 280
          && post().c0 == 0 && post().c1 == 0 && post().c2 == 0 && post().c3 == 0 && post().reports == 0
          && post().matchId is int
          && post().createdAt == request.time
          && within24h(post().expireAt);
      }

      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function votePath() { return 'communities/' + community + '/posts/' + postId + '/votes/' + me(); }
      function countUp(key, choice) {
        return changed().hasOnly([key])
          && request.resource.data[key] == resource.data[key] + 1
          && getAfter(doc(votePath())).data.choice == choice;
      }
      function validVote() {
        return !exists(doc(votePath())) && existsAfter(doc(votePath()))
          && (countUp('c0', 0) || countUp('c1', 1) || countUp('c2', 2) || countUp('c3', 3));
      }
      function reportPath() { return 'communities/' + community + '/posts/' + postId + '/reports/' + me(); }
      function validReport() {
        return changed().hasOnly(['reports'])
          && request.resource.data.reports == resource.data.reports + 1
          && !exists(doc(reportPath())) && existsAfter(doc(reportPath()));
      }

      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 100;
      allow create: if signedIn() && (validPost() || validMatchPoll());
      allow update: if signedIn() && (validVote() || validReport());
      allow delete: if signedIn() && resource.data.uid == me();

      match /votes/{uid} {
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['choice', 'expireAt'])
          && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice <= 3
          && request.resource.data.expireAt is timestamp;
      }
      match /reports/{uid} {
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['expireAt'])
          && request.resource.data.expireAt is timestamp;
      }
    }
  }
}
